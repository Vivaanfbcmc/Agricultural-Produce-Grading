// ── POST /price  —  main endpoint ────────────────────────
//  Body fields (all optional except grade):
//    grade      "A" | "B" | "C" | "rotten"   ← required
//    commodity  default = "Tomato"
//    state      default = "Maharashtra"
//    district   default = "Sholapur"  (set "" to get all)
// ─────────────────────────────────────────────────────────
app.post("/price", async (req, res) => {
    cw.sep();
    cw.info("POST /price  →  body:", JSON.stringify(req.body));

    const {
        commodity = DEFAULT_COMMODITY,
        grade,
        state     = DEFAULT_STATE,
        district  = DEFAULT_DISTRICT,
    } = req.body || {};

    // ── Validate grade ─────────────────────────────────────
    if (!grade) {
        cw.warn("Missing 'grade' field in request body");
        return res.status(400).json({
            success: false,
            message: "Missing required field: grade  (send A / B / C / rotten)",
            received: req.body,
        });
    }

    cw.info(`  commodity=${commodity}  grade=${grade}  state=${state}  district=${district || "(all)"}`);

    // ── Rotten → instant reject ────────────────────────────
    if (grade.toLowerCase() === "rotten") {
        cw.ok("Grade=rotten → rejected, ₹0");
        return res.json({
            success:       true,
            grade:         "rotten",
            price:         0,
            price_display: "₹0 — Rejected (rotten)",
            message:       "Tomato is rotten and cannot be sold",
        });
    }

    // ── Validate grade value ───────────────────────────────
    if (!["A", "B", "C"].includes(grade.toUpperCase())) {
        cw.warn("Invalid grade:", grade);
        return res.status(400).json({
            success: false,
            message: `Invalid grade "${grade}" — must be A, B, C, or rotten`,
        });
    }

    try {
        // STEP 1 — fetch
        const records = await fetchDataGovRecords({ commodity, state, district });

        if (!records || records.length === 0) {
            cw.warn("No records returned from API");
            return res.status(404).json({
                success: false,
                message: `No data for commodity="${commodity}" state="${state}" district="${district || "all"}"`,
                debug_tips: [
                    "Check spelling: commodity='Tomato' state='Maharashtra'",
                    "Try district='' to remove district filter",
                    "data.gov.in can be 24-48h behind — try again tomorrow",
                    "Hit GET /debug to see raw API response",
                ],
            });
        }

        // STEP 2 — compute
        const result = computeSmartPrice(records, grade);

        if (!result) {
            cw.error("computeSmartPrice returned null");
            return res.status(500).json({
                success: false,
                message: "Price computation failed — all price fields were zero",
                debug_tips: [
                    "Check terminal: look for 'sample record[0] field names' log line",
                    "Field names must be 'Min Price' / 'Max Price' / 'Modal Price'",
                    "Hit GET /debug to inspect raw record structure",
                ],
            });
        }

        cw.sep();
        cw.ok(`FINAL → Grade ${grade.toUpperCase()} = ₹${result.smartPrice} / quintal`);
        cw.sep();

        return res.json({
            success:          true,
            grade:            grade.toUpperCase(),
            price:            result.smartPrice,          // ← use this in frontend
            price_display:    `₹${result.smartPrice.toLocaleString("en-IN")} per quintal`,
            price_column:     result.priceColumn,

            // all 3 weighted prices for reference
            min_price:        result.weightedMin,
            modal_price:      result.weightedModal,
            max_price:        result.weightedMax,

            // stats for debugging
            records_used:     result.recordsUsed,
            total_fetched:    result.totalFetched,
            outliers_removed: result.outliersRemoved,
            data_date_range:  `${result.dateFrom} → ${result.dateTo}`,
            lookback_days:    LOOKBACK_DAYS,
            source:           "data.gov.in / AGMARKNET",
            location:         { state, district: district || "all" },
            timestamp:        new Date().toISOString(),
            message:          `Grade ${grade.toUpperCase()} smart price from ${result.recordsUsed} clean records`,
        });

    } catch (err) {
        cw.error("Unhandled error:", err.message);
        cw.error("Stack:", err.stack?.split("\n").slice(0,4).join("\n"));
        return res.status(500).json({
            success:    false,
            message:    err.message,
            debug_tips: [
                "Watch terminal for [PG] logs — every step is traced",
                "Try GET /debug?commodity=Tomato&state=Maharashtra&limit=3",
                "Check DATAGOV_API_KEY is valid at https://data.gov.in",
            ],
        });
    }
});

// ── GET /price  —  browser / Postman quick test ──────────
app.get("/price", (req, res) => {
    req.body = req.query;
    app._router.handle(
        { ...req, method: "POST", url: "/price", body: req.query },
        res, () => {}
    );
});

// ── GET /debug  —  raw API passthrough ───────────────────
// Use this to see the exact field names data.gov.in is returning.
// Very useful when prices come back as 0 — just hit this endpoint
// and look at what records[0] looks like.
//
// Example: GET /debug?commodity=Tomato&state=Maharashtra&limit=3
// ─────────────────────────────────────────────────────────
app.get("/debug", async (req, res) => {
    cw.info("GET /debug — raw data.gov.in passthrough");

    const commodity = req.query.commodity || DEFAULT_COMMODITY;
    const state     = req.query.state     || DEFAULT_STATE;
    const district  = req.query.district  !== undefined ? req.query.district : DEFAULT_DISTRICT;
    const limit     = req.query.limit     || "5";

    const params = new URLSearchParams({
        "api-key":            DATAGOV_API_KEY,
        "format":             "json",
        "limit":              limit,
        "offset":             "0",
        "filters[commodity]": commodity,
        "filters[state]":     state,
    });
    if (district) params.append("filters[district]", district);

    const url       = `${DATAGOV_BASE_URL}?${params.toString()}`;
    const maskedURL = url.replace(DATAGOV_API_KEY, "***KEY***");

    cw.info("Debug URL:", maskedURL);

    try {
        const r    = await fetch(url);
        const json = await r.json();
        return res.json({
            debug:             true,
            http_status:       r.status,
            note:              "Raw response from data.gov.in — check records[0] for exact field names",
            url_used:          maskedURL,
            field_names_in_r0: json.records?.[0] ? Object.keys(json.records[0]) : "no records",
            response:          json,
        });
    } catch (e) {
        cw.error("Debug endpoint error:", e.message);
        return res.status(500).json({ debug: true, error: e.message });
    }
});

